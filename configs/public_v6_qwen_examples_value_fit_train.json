{
  "models": {"qwen": "qwen3.8-27b"},
  "channels": [
    {
      "name": "qwen_external",
      "models": {"qwen3.8-27b": "qwen3.8-27b"},
      "base_url": "http://127.0.0.1:18081/v1",
      "host_header": "gateway.internal.example",
      "credential_config": "~/.config/nl2sql/qwen_gateway_current.json"
    }
  ],
  "templates": ["standard", "reread"],
  "samples_per_template": 2,
  "temperature": 0.7,
  "max_tokens": 2048,
  "reasoning_effort": "medium",
  "workers": 8,
  "exec_workers": 8,
  "exec_timeout_s": 30.0,
  "max_result_rows": 10000,
  "sample_values": 3,
  "value_hints": true,
  "value_hint_max_values": 400,
  "value_hint_max_length": 60,
  "value_hint_topk": 14,
  "train_examples_file": "~/project/nl2sql_harness/datasets/train/fit_train.json",
  "train_example_count": 3,
  "train_example_exclude_files": [
    "~/project/nl2sql_harness/datasets/train/fit_val.json",
    "~/project/nl2sql_harness/datasets/train/holdout.json"
  ]
}
